#
# Copy to .env (or run scripts/init-env.sh, which also generates the password).
# Never commit .env.

# Variable names follow Immich's (.env of its docker-compose) where they overlap.

# --- Storage ----------------------------------------------------------------
# Where uploaded files (and thumbnails) are stored on the host.
UPLOAD_LOCATION=./library
# Where PostgreSQL keeps its files (network shares are not supported here).
DB_DATA_LOCATION=./postgres
# The server and worker run as this user so they can write to UPLOAD_LOCATION.
# scripts/init-env.sh sets them to your own user.
DRIVICH_UID=10001
DRIVICH_GID=10001

# --- Time -------------------------------------------------------------------
# TZ=Europe/Paris

# --- Version ----------------------------------------------------------------
# Tag of the images. Leave unset: a clone builds and runs `local`, and the
# docker-compose.yml of a release already names its own version.
# DRIVICH_VERSION=

# --- Database ---------------------------------------------------------------
DB_USERNAME=drivich
DB_DATABASE_NAME=drivich
# Required. Generated by scripts/init-env.sh. Use only A-Za-z0-9.
DB_PASSWORD=

# --- Network ----------------------------------------------------------------
# Port published on the host for the web app (the API is not exposed).
DRIVICH_PORT=2283
# Use 127.0.0.1 to listen on this machine only (e.g. behind your own reverse proxy).
DRIVICH_BIND_ADDRESS=0.0.0.0
# Set to true when you serve Drivich over HTTPS.
DRIVICH_COOKIE_SECURE=false

# --- Safety ----------------------------------------------------------------
# The server refuses to start when the database knows stored files but the
# library folder looks empty (volume not mounted). Only set true if you are sure.
DRIVICH_IGNORE_MOUNT_CHECK_ERRORS=false

# --- Limits -----------------------------------------------------------------
# Maximum size of one file in bytes (0 = unlimited).
DRIVICH_MAX_FILE_BYTES=0
DRIVICH_TRASH_DAYS=30
DRIVICH_UPLOAD_TTL_HOURS=48
DRIVICH_SESSION_DAYS=30

# --- Database backups --------------------------------------------------------
# Daily pg_dump into UPLOAD_LOCATION/backups, newest N kept (like Immich).
DRIVICH_BACKUPS_ENABLED=true
DRIVICH_BACKUP_KEEP=14

# --- Worker -----------------------------------------------------------------
DRIVICH_WORKER_CONCURRENCY=2
DRIVICH_THUMB_MAX_PX=480
# false = smaller worker image, no video thumbnails.
WITH_FFMPEG=true
# false = about 400 MB smaller worker image, no Word/Excel/PowerPoint previews
# (LibreOffice renders them to PDF on first view, one at a time).
WITH_OFFICE=true

# --- Files ------------------------------------------------------------------
# Older versions kept per file (they count towards the owner's quota).
DRIVICH_MAX_VERSIONS=20
# Folder .zip downloads served at the same time (each uses one thread).
DRIVICH_MAX_ZIP_STREAMS=4

# --- Memory limits per container --------------------------------------------
DRIVICH_DB_MEM=512m
DRIVICH_SERVER_MEM=256m
DRIVICH_WORKER_MEM=1536m
DRIVICH_WEB_MEM=64m

RUST_LOG=info
