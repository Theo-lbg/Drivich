#
# Rendered by the nginx image entrypoint (envsubst): ${DRIVICH_SERVER_URL}, ${DRIVICH_OFFICE_URL}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}
# Behind another reverse proxy (HTTPS, public host name), trust what it forwards.
map $http_x_forwarded_proto $office_proto {
    default $scheme;
    https   https;
    http    http;
    # Traefik (and others) announce WebSocket requests as ws / wss.
    wss     https;
    ws      http;
}
map $http_x_forwarded_host $office_host {
    default $http_x_forwarded_host;
    ''      $http_host;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Uploads are chunked by the client, but never impose a body limit here.
    client_max_body_size 0;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # API: streamed both ways, long timeouts for big files.
    location /api/ {
        proxy_pass ${DRIVICH_SERVER_URL};
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Optional ONLYOFFICE Document Server (profile `office`), same origin as the app.
    # Resolved per request so the web container starts even when it is not running.
    location /onlyoffice/ {
        resolver 127.0.0.11 valid=10s;
        set $office ${DRIVICH_OFFICE_URL};
        rewrite ^/onlyoffice/(.*)$ /$1 break;
        proxy_pass $office;
        proxy_http_version 1.1;
        proxy_buffering off;
        client_max_body_size 0;
        proxy_read_timeout 3600s;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $office_host/onlyoffice;
        proxy_set_header X-Forwarded-Proto $office_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Fingerprinted build output: cache for a year.
    location /_app/immutable/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        try_files $uri =404;
    }

    # Single-page app: every other route is index.html.
    location / {
        # add_header in a location replaces the server-level ones, so repeat them.
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        try_files $uri $uri/ /index.html;
    }
}
